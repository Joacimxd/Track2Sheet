# Spotify Basic Pitch (audio -> MIDI). Separate image because basic-pitch's model runtimes
# (TensorFlow / tflite / ONNX) don't support the Python 3.12 used by the main image yet.
FROM python:3.11-slim

# ffmpeg: decode MP3 stems; libsndfile1: soundfile/librosa
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.basicpitch.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

ARG HOST_UID=1000
ARG HOST_GID=1000
RUN existing="$(getent group "${HOST_GID}" | cut -d: -f1)"; \
    if [ -z "$existing" ]; then groupadd -g "${HOST_GID}" app; existing=app; fi; \
    useradd -m -u "${HOST_UID}" -g "$existing" -o app
USER app

WORKDIR /workspace
EXPOSE 8888

CMD ["sh", "-c", "jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.token=\"$JUPYTER_TOKEN\" --ServerApp.root_dir=/workspace --LabApp.default_url=/lab/tree/notebooks/stem2midi.ipynb"]
