  "components": [
    {
      "name": "Play Button",
      "kind": "button",
      "refersTo": "button-play",
      "description": "The one loud control: warm-ink disc that starts and pauses the band.",
      "html": "<button class=\"ds-btn-play\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\"><path d=\"M7 4l13 8-13 8z\"/></svg></button>",
      "css": ".ds-btn-play{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border:0;border-radius:9999px;background:var(--color-ink,#f2efe9);color:var(--color-stage,#0e0f12);cursor:pointer;transition:background 150ms,transform 150ms}.ds-btn-play:hover{background:#fff}.ds-btn-play:active{transform:scale(.95)}.ds-btn-play:focus-visible{outline:2px solid var(--color-ink,#f2efe9);outline-offset:2px}"
    },
    {
      "name": "Icon Button (mute / solo)",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "32px mixer toggles: control fill at rest, alert tint when muted, ink when soloed.",
      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-btn-icon\" aria-label=\"Silenciar\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M11 5L6 9H2v6h4l5 4z\"/><path d=\"M15.5 8.5a5 5 0 010 7\"/></svg></button><button class=\"ds-btn-icon ds-mute-on\" aria-label=\"Silenciada\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M11 5L6 9H2v6h4l5 4z\"/><path d=\"M22 9l-6 6M16 9l6 6\"/></svg></button><button class=\"ds-btn-icon ds-solo-on\" aria-label=\"Solo\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 14h3a2 2 0 012 2v3a2 2 0 01-2 2H5a2 2 0 01-2-2v-7a9 9 0 0118 0v7a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3\"/></svg></button></div>",
      "css": ".ds-btn-icon{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:0;border-radius:6px;background:var(--color-control,#25272d);color:var(--color-ink-2,#b9b5ac);cursor:pointer;transition:background 150ms,color 150ms,transform 150ms}.ds-btn-icon:hover{background:#2e3037;color:var(--color-ink,#f2efe9)}.ds-btn-icon:active{transform:scale(.95)}.ds-btn-icon:focus-visible{outline:2px solid var(--color-ink,#f2efe9);outline-offset:2px}.ds-mute-on,.ds-mute-on:hover{background:rgba(224,80,58,.2);color:var(--color-alert,#e0503a)}.ds-solo-on,.ds-solo-on:hover{background:var(--color-ink,#f2efe9);color:var(--color-stage,#0e0f12)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet utility action such as loading files.",
      "html": "<button class=\"ds-btn-secondary\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3v12M7 8l5-5 5 5M5 21h14\"/></svg>Cargar archivos</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border:0;border-radius:6px;background:var(--color-control,#25272d);color:var(--color-ink-2,#b9b5ac);font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:background 150ms,color 150ms,transform 150ms}.ds-btn-secondary:hover{background:#2e3037;color:var(--color-ink,#f2efe9)}.ds-btn-secondary:active{transform:scale(.97)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-ink,#f2efe9);outline-offset:2px}"
    },
    {
      "name": "YouTube Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Link field with a nested ink submit button.",
      "html": "<form class=\"ds-field\" onsubmit=\"return false\"><input class=\"ds-field-input\" placeholder=\"Pega un link de YouTube\"><button class=\"ds-field-submit\">Procesar</button></form>",
      "css": ".ds-field{display:flex;align-items:center;gap:8px;height:44px;padding:0 4px 0 10px;border:1px solid var(--color-rule,#2c2e34);border-radius:6px;background:var(--color-control,#25272d);transition:border-color 150ms}.ds-field:focus-within{border-color:var(--color-ink-3,#8a877f)}.ds-field-input{flex:1;min-width:0;height:100%;border:0;background:transparent;color:var(--color-ink,#f2efe9);font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-size:14px;outline:none}.ds-field-input::placeholder{color:var(--color-ink-3,#8a877f)}.ds-field-submit{height:32px;padding:0 10px;border:0;border-radius:4px;background:var(--color-ink,#f2efe9);color:var(--color-stage,#0e0f12);font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:background 150ms,transform 150ms}.ds-field-submit:hover{background:#fff}.ds-field-submit:active{transform:scale(.95)}"
    },
    {
      "name": "Toco Segmented Switch",
      "kind": "nav",
      "refersTo": "segmented-switch",
      "description": "Picks the practised instrument; the active segment takes that instrument's gel.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-opt ds-seg-on\" role=\"radio\" aria-checked=\"true\">Guitarra</button><button class=\"ds-seg-opt\" role=\"radio\" aria-checked=\"false\">Batería</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border-radius:6px;background:var(--color-control,#25272d)}.ds-seg-opt{height:32px;padding:0 14px;border:0;border-radius:4px;background:transparent;color:var(--color-ink-2,#b9b5ac);font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background-color 200ms,color 200ms}.ds-seg-opt:hover{color:var(--color-ink,#f2efe9)}.ds-seg-opt:focus-visible{outline:2px solid var(--color-ink,#f2efe9);outline-offset:2px}.ds-seg-on,.ds-seg-on:hover{background:var(--color-gel-guitar,#f0b429);color:#111214}"
    },
    {
      "name": "Seek Bar",
      "kind": "custom",
      "refersTo": "seek-bar",
      "description": "Song position with tabular condensed times; fill in the mode gel.",
      "html": "<div class=\"ds-seek\"><span class=\"ds-time\">01:12</span><div class=\"ds-seek-track\" tabindex=\"0\"><div class=\"ds-seek-fill\"></div><div class=\"ds-seek-thumb\"></div></div><span class=\"ds-time ds-time-total\">03:48</span></div>",
      "css": ".ds-seek{display:flex;align-items:center;gap:12px;min-width:260px}.ds-time{font-family:'Barlow Condensed','Barlow',ui-sans-serif,sans-serif;font-size:20px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--color-ink,#f2efe9)}.ds-time-total{color:var(--color-ink-3,#8a877f)}.ds-seek-track{position:relative;flex:1;height:6px;border-radius:9999px;background:var(--color-control,#25272d);cursor:pointer;outline:none}.ds-seek-fill{width:32%;height:100%;border-radius:9999px;background:var(--color-gel-guitar,#f0b429)}.ds-seek-thumb{position:absolute;top:50%;left:32%;width:14px;height:14px;border-radius:9999px;background:var(--color-ink,#f2efe9);transform:translate(-50%,-50%);opacity:0;transition:opacity 150ms}.ds-seek-track:hover .ds-seek-thumb,.ds-seek-track:focus-visible .ds-seek-thumb{opacity:1}"
    },
    {
      "name": "Mixer Row with Gel Swatch",
      "kind": "custom",
      "refersTo": "gel-swatch-lit",
      "description": "Signature: the gel swatch lights while the stem sounds and drops to an unlit filter when muted; the meter is the light through it.",
      "html": "<ul class=\"ds-mixer\"><li class=\"ds-row\"><span class=\"ds-gel\" style=\"--gel:#d65aa0\">VOZ</span><div class=\"ds-row-text\"><p class=\"ds-row-name\">Voces</p><p class=\"ds-row-cap\">vocals.wav</p></div><div class=\"ds-meter\"><i style=\"width:62%;background:#d65aa0\"></i></div></li><li class=\"ds-row ds-row-practised\" style=\"--gel:#f0b429\"><span class=\"ds-gel ds-gel-off\">GTR</span><div class=\"ds-row-text\"><p class=\"ds-row-name ds-dim\">Guitarra</p><p class=\"ds-row-cap\" style=\"color:#f0b429\">La tocas tú</p></div><div class=\"ds-meter\"><i style=\"width:0\"></i></div></li></ul>",
      "css": ".ds-mixer{list-style:none;margin:0;padding:0;width:320px}.ds-row{display:flex;align-items:center;gap:10px;padding:10px 8px;border-bottom:1px solid var(--color-rule,#2c2e34)}.ds-row-practised{background:color-mix(in srgb,var(--gel) 7%,transparent)}.ds-gel{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:44px;height:44px;border-radius:6px;background:var(--gel);color:#111214;font-family:'Barlow Condensed','Barlow',ui-sans-serif,sans-serif;font-size:14px;font-weight:600;letter-spacing:.025em;transition:background-color 200ms ease-out,color 200ms ease-out}.ds-gel-off{background:color-mix(in srgb,var(--gel) 12%,transparent);color:var(--gel)}.ds-row-text{flex:1;min-width:0}.ds-row-name{margin:0;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-size:15px;font-weight:600;line-height:1.25;color:var(--color-ink,#f2efe9)}.ds-dim{color:var(--color-ink-2,#b9b5ac)}.ds-row-cap{margin:0;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-size:12px;color:var(--color-ink-3,#8a877f)}.ds-meter{width:80px;height:4px;border-radius:2px;background:var(--color-control,#25272d);overflow:hidden}.ds-meter i{display:block;height:100%;border-radius:2px}"
    },
    {
      "name": "Fader",
      "kind": "input",
      "refersTo": "fader",
      "description": "Per-stem volume: 3px hard-stop track, ink thumb that grows on hover.",
      "html": "<input type=\"range\" class=\"ds-fader\" min=\"0\" max=\"100\" value=\"70\" aria-label=\"Volumen\">",
      "css": ".ds-fader{appearance:none;-webkit-appearance:none;width:96px;height:18px;background:transparent;cursor:pointer}.ds-fader::-webkit-slider-runnable-track{height:3px;border-radius:2px;background:linear-gradient(to right,var(--color-ink-2,#b9b5ac) 70%,var(--color-control,#25272d) 70%)}.ds-fader::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;margin-top:-4.5px;border-radius:50%;background:var(--color-ink,#f2efe9);transition:transform 150ms ease-out}.ds-fader:hover::-webkit-slider-thumb{transform:scale(1.2)}.ds-fader::-moz-range-track{height:3px;border-radius:2px;background:var(--color-control,#25272d)}.ds-fader::-moz-range-progress{height:3px;border-radius:2px;background:var(--color-ink-2,#b9b5ac)}.ds-fader::-moz-range-thumb{width:12px;height:12px;border:0;border-radius:50%;background:var(--color-ink,#f2efe9)}.ds-fader:focus-visible{outline:2px solid var(--color-ink,#f2efe9);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Gel Swatchbook",
    "overview": "Each of the six stems is a stage-lighting gel. What sounds is lit; what is muted goes dark. The whole interface is a black stage with warm off-white ink, and colour enters only through those six gels: the practised instrument's gel names the mode everywhere it appears (the seek fill, the active \"Toco\" segment, the tint on its mixer row, its notes on the highway). Everything else stays neutral so that colour always means \"this part of the band\".\n\nThe density is that of an operating surface read from a stool a few feet away: one top bar, a full-height highway canvas, one right column. Regions are full-bleed bands separated by 1px rules, not floating cards. Fills are flat; depth comes from three stacked dark tones and from the highway's own perspective, never from glow or ambient shadow. The interface is always dark.\n\nThe world refuses two things outright: the neon-glow rhythm-game look (halos, bloom, gradient chrome) and the grey DAW mixer with a single blue accent.",
    "keyCharacteristics": [
      "Black stage, lifted panel, warm ink; colour comes only from the six stem gels.",
      "The gel swatch lights (solid gel, dark ink) when the stem sounds and drops to an unlit filter (12% gel, gel-coloured text) when muted.",
      "Full-bleed bands divided by 1px rules; no cards.",
      "Flat fills, 6px corners, tabular numerals in Barlow Condensed.",
      "Spanish UI copy throughout."
    ],
    "rules": [
      {
        "name": "The Gel-Only Chroma Rule",
        "body": "Colour outside the neutral ramp comes only from the six stem gels (plus String Orange on the fretboard). No brand accent, no blue \"primary\". If a colour on screen doesn't name a stem, it should be ink or graphite.",
        "section": "colors"
      },
      {
        "name": "The Lit / Unlit Rule",
        "body": "A sounding stem shows its gel at full strength with Gel Ink on it; a muted or silent stem shows the same gel at 12% with gel-coloured text. State is carried by light, not by icons alone.",
        "section": "colors"
      },
      {
        "name": "The Mode Gel Rule",
        "body": "The practised instrument's gel is applied to every control that expresses the practice mode, so switching guitar/drums recolours the seek fill, the switch, and the row tint together.",
        "section": "colors"
      },
      {
        "name": "The Condensed-For-Reading-At-Distance Rule",
        "body": "Anything the player must read from the stool (time, fret numbers, swatch codes, section names) is Barlow Condensed 600. Barlow body sizes are for controls reached with the mouse.",
        "section": "typography"
      },
      {
        "name": "The No-Halo Rule",
        "body": "A note about to be played brightens its gel fill; it never glows. No `shadowBlur`, bloom, or coloured halos anywhere, chrome or canvas.",
        "section": "elevation"
      },
      {
        "name": "The Functional-Gradient Rule",
        "body": "Gradients exist only where they do a job: the fader's hard-stop fill, the highway's readability shade and neck tone. Never as decoration on chrome.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** take every non-neutral colour from the six stem gels via `--color-gel-*` / `STEM_GEL`, and keep the two in sync.",
      "**Do** print Gel Ink (#111214) on any lit gel, and gel-coloured text on an unlit (12%) gel.",
      "**Do** recolour every practice-mode control with the practised instrument's gel when the instrument changes.",
      "**Do** divide regions and list rows with 1px rules on full-bleed bands.",
      "**Do** use 6px corners for controls and containers, 4px for elements nested inside them.",
