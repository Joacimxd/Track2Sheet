# Song to process (change this, or paste a URL in the notebook)
YOUTUBE_URL=

# Paths (relative to project root)
OUTPUT_DIR=output
MODEL_DIR=models

# Separation
SEPARATION_MODEL=BS-Roformer-SW.ckpt
STEM_FORMAT=WAV

# Optional: cookies file for yt-dlp if YouTube asks you to sign in
# YTDLP_COOKIES=cookies.txt

# Jupyter
JUPYTER_PORT=8888
BASICPITCH_PORT=8889   # stem -> MIDI notebook (docker compose --profile basicpitch up)
JUPYTER_TOKEN=changeme

# Your user/group so files in output/ belong to you (`id -u` / `id -g`)
HOST_UID=1000
HOST_GID=1000

# Uncomment for NVIDIA GPU (needs NVIDIA Container Toolkit):
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
